𝐛𝐞𝐠𝐢𝐧
  { srv68 - ein minimaler HTTP-Server in Algol 68.
    Liefert die Tabellen der Chinook-Beispieldatenbank (die auch das
    Projekt sql68 benutzt) ueber eine kleine REST-API als JSON. Jede
    Route stellt eine Tabelle ausfuehren und der Body wird per SQL geholt. }

  { Socket-Anbindung: socket/bind/listen/accept gibt es nicht in der
    POSIX-Prelude, also ueber nest C aus einer kleinen C-Quelle beziehen.
    Alles Weitere (Lesen/Schreiben auf dem File-Descriptor) liefert die
    POSIX-Prelude (fgetc/fputs/fclose).
    Fuer echte Multithreading-Worker kommt eine pthread-Unterstuetzung
    aus thread_wrapper.c zum Einsatz. }

  𝐩𝐫𝐨𝐜(𝐢𝐧𝐭) 𝐢𝐧𝐭 socket_listen = 𝐧𝐞𝐬𝐭 𝐜 "algol68_socket_listen";
  𝐩𝐫𝐨𝐜(𝐢𝐧𝐭) 𝐢𝐧𝐭 socket_accept = 𝐧𝐞𝐬𝐭 𝐜 "algol68_socket_accept";
  𝐩𝐫𝐨𝐜(𝐢𝐧𝐭, 𝐢𝐧𝐭, 𝐩𝐫𝐨𝐜(𝐢𝐧𝐭) 𝐯𝐨𝐢𝐝) 𝐯𝐨𝐢𝐝 server_serve =
    𝐧𝐞𝐬𝐭 𝐜 "algol68_server_serve";

  { SQLite-Anbindung: gleiche NEST-C-Technik wie im Projekt sql68.
    Das Ergebnis der Abfrage formt algol68_sqlite_exec_json direkt zu
    einem JSON-Array (thread-sicher, daher kein Algol-Callback). }
  𝐦𝐨𝐝𝐞 𝐬𝐪𝐥𝐢𝐭𝐞 = 𝐥𝐨𝐧𝐠 𝐛𝐢𝐭𝐬;
  𝐩𝐫𝐨𝐜(𝐬𝐭𝐫𝐢𝐧𝐠, 𝐫𝐞𝐟 𝐬𝐪𝐥𝐢𝐭𝐞) 𝐢𝐧𝐭 sqlite_open = 𝐧𝐞𝐬𝐭 𝐜 "algol68_sqlite_open";
  𝐩𝐫𝐨𝐜(𝐬𝐪𝐥𝐢𝐭𝐞, 𝐬𝐭𝐫𝐢𝐧𝐠) 𝐬𝐭𝐫𝐢𝐧𝐠 sqlite_exec_json =
    𝐧𝐞𝐬𝐭 𝐜 "algol68_sqlite_exec_json";
  𝐩𝐫𝐨𝐜(𝐬𝐪𝐥𝐢𝐭𝐞) 𝐢𝐧𝐭 sqlite_close = 𝐧𝐞𝐬𝐭 𝐜 "algol68_sqlite_close";

  { Antwort byte-genau auf den Socket schreiben (umgeht einen ga68-POSIX-
    fputs-Bug, der nur die Zeichenanzahl aus dem UTF-8-Puffer schreibt). }
  𝐩𝐫𝐨𝐜(𝐢𝐧𝐭, 𝐬𝐭𝐫𝐢𝐧𝐠) 𝐢𝐧𝐭 write_all = 𝐧𝐞𝐬𝐭 𝐜 "algol68_write_all";

{ String, der nur Ziffern enthaelt, in int verwandeln }
  𝐩𝐫𝐨𝐜(𝐬𝐭𝐫𝐢𝐧𝐠) 𝐢𝐧𝐭 𝑠2𝑖 =
    (𝐬𝐭𝐫𝐢𝐧𝐠 𝑠) 𝐢𝐧𝐭:
      𝐛𝐞𝐠𝐢𝐧
        𝐢𝐧𝐭 𝑣 ← 0;
        𝐟𝐨𝐫 𝑖 𝐟𝐫𝐨𝐦 𝐥𝐰𝐛 𝑠 𝐭𝐨 𝐮𝐩𝐛 𝑠 𝐝𝐨
          𝑣 ← 𝑣 * 10 + (𝐚𝐛𝐬 𝑠[𝑖] - 𝐚𝐛𝐬 "0")
        𝐨𝐝;
        𝑣
      𝐞𝐧𝐝;

  { Eine Zeile (bis Zeilenende) von einem File-Descriptor lesen.
    fgets aus der POSIX-Prelude ist fehlerhaft (Segfault), daher
    zeichenweise mit fgetc. Die Zeilenende-Zeichen werden verworfen. }
  𝐩𝐫𝐨𝐜(𝐢𝐧𝐭, 𝐢𝐧𝐭) 𝐬𝐭𝐫𝐢𝐧𝐠 read_line =
    (𝐢𝐧𝐭 𝑓𝑑, 𝐢𝐧𝐭 max_len) 𝐬𝐭𝐫𝐢𝐧𝐠:
      𝐛𝐞𝐠𝐢𝐧
        [1:max_len] 𝐜𝐡𝐚𝐫 𝑏𝑢𝑓;
        𝐢𝐧𝐭 𝑛 ← 0;
        𝐛𝐨𝐨𝐥 𝑑𝑜𝑛𝑒 ← 𝐟𝐚𝐥𝐬𝐞;
        𝐰𝐡𝐢𝐥𝐞 𝐧𝐨𝐭 𝑑𝑜𝑛𝑒 𝐝𝐨
          𝐜𝐡𝐚𝐫 𝑐 ← 𝑓𝑔𝑒𝑡𝑐(𝑓𝑑);
          𝐢𝐟 𝑐 = 𝑒𝑜𝑓𝑐ℎ𝑎𝑟 𝐭𝐡𝐞𝐧
            𝑑𝑜𝑛𝑒 ← 𝐭𝐫𝐮𝐞
          𝐞𝐥𝐢𝐟 𝑐 = "'n" 𝐭𝐡𝐞𝐧
            𝑑𝑜𝑛𝑒 ← 𝐭𝐫𝐮𝐞
          𝐞𝐥𝐢𝐟 𝑛 < max_len 𝐭𝐡𝐞𝐧
            𝑛 +← 1;
            𝑏𝑢𝑓[𝑛] ← 𝑐
          𝐟𝐢
        𝐨𝐝;
        𝑏𝑢𝑓[1:𝑛]
      𝐞𝐧𝐝;

  { Position des ersten Auftretens von c in s; 0 wenn nicht enthalten }
  𝐩𝐫𝐨𝐜(𝐬𝐭𝐫𝐢𝐧𝐠, 𝐜𝐡𝐚𝐫) 𝐢𝐧𝐭 𝑓𝑖𝑛𝑑𝑐 =
    (𝐬𝐭𝐫𝐢𝐧𝐠 𝑠, 𝐜𝐡𝐚𝐫 𝑐) 𝐢𝐧𝐭:
      𝐛𝐞𝐠𝐢𝐧
        𝐢𝐧𝐭 𝑟 ← 0;
        𝐟𝐨𝐫 𝑘 𝐟𝐫𝐨𝐦 𝐥𝐰𝐛 𝑠 𝐭𝐨 𝐮𝐩𝐛 𝑠 𝐰𝐡𝐢𝐥𝐞 𝑟 = 0 𝐝𝐨
          𝐢𝐟 𝑠[𝑘] = 𝑐 𝐭𝐡𝐞𝐧 𝑟 ← 𝑘 𝐟𝐢
        𝐨𝐝;
        𝑟
      𝐞𝐧𝐝;

  { Aus der Request-Zeile den URL-Pfad herauslesen, z.B.
    "GET /api/users?x=1 HTTP/1.1" -> "/api/users". }
  𝐩𝐫𝐨𝐜(𝐬𝐭𝐫𝐢𝐧𝐠) 𝐬𝐭𝐫𝐢𝐧𝐠 extract_path =
    (𝐬𝐭𝐫𝐢𝐧𝐠 𝑟𝑒𝑞𝑢𝑒𝑠𝑡) 𝐬𝐭𝐫𝐢𝐧𝐠:
      𝐛𝐞𝐠𝐢𝐧
        𝐢𝐧𝐭 𝑠𝑝1 ← 𝑓𝑖𝑛𝑑𝑐(𝑟𝑒𝑞𝑢𝑒𝑠𝑡, " ");
        𝐬𝐭𝐫𝐢𝐧𝐠 ℎ𝑒𝑎𝑑 ← 𝑟𝑒𝑞𝑢𝑒𝑠𝑡[𝑠𝑝1+1:𝐮𝐩𝐛 𝑟𝑒𝑞𝑢𝑒𝑠𝑡];
        𝐢𝐧𝐭 𝑠𝑝2 ← 𝑓𝑖𝑛𝑑𝑐(ℎ𝑒𝑎𝑑, " ");
        𝐬𝐭𝐫𝐢𝐧𝐠 𝑝𝑎𝑡ℎ ← ℎ𝑒𝑎𝑑[𝐥𝐰𝐛 ℎ𝑒𝑎𝑑:𝑠𝑝2-1];
        𝐢𝐧𝐭 𝑞 ← 𝑓𝑖𝑛𝑑𝑐(𝑝𝑎𝑡ℎ, "?");
        𝐢𝐟 𝑞 > 0 𝐭𝐡𝐞𝐧
          𝑝𝑎𝑡ℎ ← 𝑝𝑎𝑡ℎ[𝐥𝐰𝐛 𝑝𝑎𝑡ℎ:𝑞-1]
        𝐟𝐢;
        𝑝𝑎𝑡ℎ
      𝐞𝐧𝐝;

  { Datenbankzugriff: dieselbe Datenbank wie im Projekt sql68 - die
    Chinook-Beispieldatenbank. }
  𝐬𝐭𝐫𝐢𝐧𝐠 db_path ← "/Users/olf/Library/Application Support/TablePro/Samples/Chinook.sqlite";

  { Routentabelle: URL-Pfad und passende Tabelle in Chinook }
  𝐦𝐨𝐝𝐞 𝐫𝐨𝐮𝐭𝐞 = 𝐬𝐭𝐫𝐮𝐜𝐭 (𝐬𝐭𝐫𝐢𝐧𝐠 𝑝𝑎𝑡ℎ, 𝐬𝐭𝐫𝐢𝐧𝐠 𝑡𝑎𝑏𝑙𝑒);
  [1:11] 𝐫𝐨𝐮𝐭𝐞 𝑟𝑜𝑢𝑡𝑒𝑠 ←
    ( ("/api/albums",  "Album"),
      ("/api/artists", "Artist"),
      ("/api/customers", "Customer"),
      ("/api/employees", "Employee"),
      ("/api/genres",  "Genre"),
      ("/api/invoices", "Invoice"),
      ("/api/invoicelines", "InvoiceLine"),
      ("/api/mediatypes", "MediaType"),
      ("/api/playlists", "Playlist"),
      ("/api/playlisttracks", "PlaylistTrack"),
      ("/api/tracks",  "Track") );

  { Interaktiver Mini-DB-Browser: eine kleine, bewusst frameworklose
    HTML/JS-Seite, die ueber die JSON-Routen alle Chinook-Tabellen
    explorieren laesst (Filtern, Sortieren, Blaettern - alles clientseitig).
    Weil ga68 keine mehrzeiligen Strings kennt, steht jede HTML-Zeile in
    einem eigenen, einzeiligen String, verkettet mit + und per 'n
    getrennt. Doppelte Quotes im HTML werden - wie ueberall in den
    uebrigen JSON-Strings des Servers - durch "" ausgedrueckt; Apostrophe
    kommen in der Seite gar nicht vor. }
        𝐬𝐭𝐫𝐢𝐧𝐠 𝑖𝑛𝑑𝑒𝑥_ℎ𝑡𝑚𝑙 ← "<!DOCTYPE html>'n" +
    "<html lang=""de"">'n" +
    "<head>'n" +
    "<meta charset=""utf-8"">'n" +
    "<meta name=""viewport"" content=""width=device-width, initial-scale=1"">'n" +
    "<title>Chinook DB Browser</title>'n" +
    "<style>'n" +
    "  * { box-sizing: border-box; }'n" +
    "  body { margin: 0; font-family: system-ui, sans-serif; background: #f4f5f7; color: #222; }'n" +
    "  .wrap { max-width: 1100px; margin: 0 auto; padding: 16px; }'n" +
    "  h1 { margin: 0 0 4px; font-size: 1.4rem; }'n" +
    "  .sub { margin: 0 0 14px; color: #666; font-size: .9rem; }'n" +
    "  .bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }'n" +
    "  select, input, button { font: inherit; padding: 6px 10px; border: 1px solid #bbb; border-radius: 6px; background: #fff; }'n" +
    "  input { flex: 1; min-width: 180px; }'n" +
    "  .status { margin: 0 0 8px; font-size: .85rem; color: #555; min-height: 1.2em; }'n" +
    "  .box { max-height: 68vh; overflow: auto; border: 1px solid #ccc; border-radius: 8px; background: #fff; }'n" +
    "  table { width: 100%; border-collapse: separate; border-spacing: 0; white-space: nowrap; }'n" +
    "  th { position: sticky; top: 0; background: #eef0f4; border-bottom: 2px solid #ccc; padding: 6px 10px; text-align: left; cursor: pointer; user-select: none; font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; }'n" +
    "  th:hover { background: #e2e6ee; }'n" +
    "  td { padding: 5px 10px; border-bottom: 1px solid #eee; max-width: 300px; overflow: hidden; text-overflow: ellipsis; }'n" +
    "  tr:nth-child(even) td { background: #fafbfc; }'n" +
    "  .num { text-align: right; font-variant-numeric: tabular-nums; }'n" +
    "  .null { color: #999; font-style: italic; }'n" +
    "  .err { color: #b3261e; }'n" +
    "  .foot { margin-top: 12px; font-size: .75rem; color: #888; }'n" +
    "</style>'n" +
    "</head>'n" +
    "<body>'n" +
    "<div class=""wrap"">'n" +
    "  <h1>Chinook DB Browser</h1>'n" +
    "  <p class=""sub"">served by srv68 &middot; SQLite-Datenbank: Chinook.sqlite, gelesen wie im Projekt sql68</p>'n" +
    "  <div class=""bar"">'n" +
    "    <select id=""sel""></select>'n" +
    "    <input id=""f"" placeholder=""Filtern..."" autocomplete=""off"">'n" +
    "    <button id=""prev"" type=""button"">&larr;</button>'n" +
    "    <button id=""next"" type=""button"">&rarr;</button>'n" +
    "  </div>'n" +
    "  <p id=""status"" class=""status""></p>'n" +
    "  <div class=""box"">'n" +
    "    <table>'n" +
    "      <thead id=""th""></thead>'n" +
    "      <tbody id=""tb""></tbody>'n" +
    "    </table>'n" +
    "  </div>'n" +
    "  <p class=""foot"">mini DB browser &middot; Filtern, Sortieren und Blaettern clientseitig &middot; max. 50 Zeilen je Tabelle (Server-LIMIT) &middot; read-only JSON-API</p>'n" +
    "</div>'n" +
    "<script>'n" +
    "(function () {'n" +
    "  ""use strict"";'n" +
    "  var sel = document.getElementById(""sel""),'n" +
    "      filt = document.getElementById(""f""),'n" +
    "      thead = document.getElementById(""th""),'n" +
    "      tbody = document.getElementById(""tb""),'n" +
    "      status = document.getElementById(""status"");'n" +
    "  var tables = [], rows = [], filtered = [], cols = [];'n" +
    "  var page = 0, per = 25, sortKey = """", sortDir = 1;'n" +
    "'n" +
    "  function esc(s) {'n" +
    "    return String(s).replace(/&/g, ""&amp;"").replace(/</g, ""&lt;"")'n" +
    "                    .replace(/>/g, ""&gt;"");'n" +
    "  }'n" +
    "  function td(v) {'n" +
    "    if (v === null || v === undefined) return ""<td class=\""null\"">-</td>"";'n" +
    "    if (typeof v === ""number"") return ""<td class=\""num\"">"" + v + ""</td>"";'n" +
    "    return ""<td>"" + esc(v) + ""</td>"";'n" +
    "  }'n" +
    "  function applyFilter() {'n" +
    "    var q = filt.value.toLowerCase();'n" +
    "    filtered = [];'n" +
    "    rows.forEach(function (r) {'n" +
    "      var hit = !q;'n" +
    "      for (var k in r) {'n" +
    "        if (r[k] !== null && r[k] !== undefined &&'n" +
    "            String(r[k]).toLowerCase().indexOf(q) > -1) { hit = true; break; }'n" +
    "      }'n" +
    "      if (hit) filtered.push(r);'n" +
    "    });'n" +
    "    page = 0;'n" +
    "  }'n" +
    "  function sortRows() {'n" +
    "    if (!sortKey) return;'n" +
    "    var k = sortKey, d = sortDir;'n" +
    "    filtered.sort(function (a, b) {'n" +
    "      var x = a[k], y = b[k];'n" +
    "      if (x === null && y === null) return 0;'n" +
    "      if (x === null) return 1;'n" +
    "      if (y === null) return -1;'n" +
    "      if (typeof x === ""number"" && typeof y === ""number"") return (x - y) * d;'n" +
    "      x = String(x).toLowerCase();'n" +
    "      y = String(y).toLowerCase();'n" +
    "      return (x < y ? -1 : x > y ? 1 : 0) * d;'n" +
    "    });'n" +
    "  }'n" +
    "  function render() {'n" +
    "    applyFilter();'n" +
    "    sortRows();'n" +
    "    var pages = Math.max(1, Math.ceil(filtered.length / per));'n" +
    "    if (page > pages - 1) page = pages - 1;'n" +
    "    var slice = filtered.slice(page * per, page * per + per);'n" +
    "    var head = ""<tr>"";'n" +
    "    var i, c, r;'n" +
    "    for (i = 0; i < cols.length; i++) {'n" +
    "      var name = cols[i];'n" +
    "      head += ""<th data-key=\"""" + name + ""\"">"" + esc(name) +'n" +
    "              (name === sortKey ? (sortDir === 1 ? "" &uarr;"" : "" &darr;"") : """") + ""</th>"";'n" +
    "    }'n" +
    "    head += ""</tr>"";'n" +
    "    thead.innerHTML = head;'n" +
    "    var out = """";'n" +
    "    for (r = 0; r < slice.length; r++) {'n" +
    "      out += ""<tr>"";'n" +
    "      for (c = 0; c < cols.length; c++) {'n" +
    "        out += td(slice[r][cols[c]]);'n" +
    "      }'n" +
    "      out += ""</tr>"";'n" +
    "    }'n" +
    "    tbody.innerHTML = out;'n" +
    "    var s = filtered.length + "" Zeile(n) von "" + rows.length + "" geladenen Zeilen"";'n" +
    "    if (filtered.length > per) s += "" - Seite "" + (page + 1) + "" von "" + pages;'n" +
    "    status.textContent = s;'n" +
    "  }'n" +
    "  function pick() {'n" +
    "    var t = sel.value;'n" +
    "    if (!t) return;'n" +
    "    status.textContent = ""Lade "" + t + "" ..."";'n" +
    "    fetch(t).then(function (r) { return r.json(); }).then(function (d) {'n" +
    "      rows = d.rows || [];'n" +
    "      cols = rows.length ? Object.keys(rows[0]) : [];'n" +
    "      sortKey = """";'n" +
    "      sortDir = 1;'n" +
    "      render();'n" +
    "    }).catch(function (e) {'n" +
    "      status.textContent = ""Fehler beim Laden: "" + e;'n" +
    "      status.className = ""status err"";'n" +
    "    });'n" +
    "  }'n" +
    "  function load() {'n" +
    "    fetch(""api/tables"").then(function (r) { return r.json(); }).then(function (d) {'n" +
    "      var list = d.tables || [];'n" +
    "      var html = """";'n" +
    "      list.forEach(function (t) {'n" +
    "        html += ""<option value=\"""" + t + ""\"">"" + esc(t.replace(""/api/"", """")) + ""</option>"";'n" +
    "      });'n" +
    "      sel.innerHTML = html;'n" +
    "      if (list.length) pick();'n" +
    "    }).catch(function (e) {'n" +
    "      status.textContent = ""Fehler beim Laden der Tabellen: "" + e;'n" +
    "      status.className = ""status err"";'n" +
    "    });'n" +
    "  }'n" +
    "  sel.addEventListener(""change"", pick);'n" +
    "  filt.addEventListener(""input"", render);'n" +
    "  thead.addEventListener(""click"", function (e) {'n" +
    "    var el = e.target.closest(""th"");'n" +
    "    if (!el) return;'n" +
    "    var k = el.getAttribute(""data-key"");'n" +
    "    if (!k) return;'n" +
    "    if (k === sortKey) sortDir = -sortDir; else { sortKey = k; sortDir = 1; }'n" +
    "    render();'n" +
    "  });'n" +
    "  document.getElementById(""prev"").addEventListener(""click"", function () {'n" +
    "    if (page > 0) { page--; render(); }'n" +
    "  });'n" +
    "  document.getElementById(""next"").addEventListener(""click"", function () {'n" +
    "    if (page < Math.ceil(filtered.length / per) - 1) { page++; render(); }'n" +
    "  });'n" +
    "  load();'n" +
    "}());'n" +
    "</script>'n" +
    "</body>'n" +
    "</html>'n";

  { HTTP-Antwort mit Statuszeile, Content-Type und passt Content-Length
    an die Laenge des Bodys an. }
  𝐩𝐫𝐨𝐜(𝐬𝐭𝐫𝐢𝐧𝐠, 𝐬𝐭𝐫𝐢𝐧𝐠, 𝐬𝐭𝐫𝐢𝐧𝐠) 𝐬𝐭𝐫𝐢𝐧𝐠 http_response =
    (𝐬𝐭𝐫𝐢𝐧𝐠 𝑠𝑡𝑎𝑡𝑢𝑠, 𝐬𝐭𝐫𝐢𝐧𝐠 𝑐𝑡𝑦𝑝𝑒, 𝐬𝐭𝐫𝐢𝐧𝐠 𝑏𝑜𝑑𝑦) 𝐬𝐭𝐫𝐢𝐧𝐠:
      "HTTP/1.1 " + 𝑠𝑡𝑎𝑡𝑢𝑠 + "'r'n"
      + "Content-Type: " + 𝑐𝑡𝑦𝑝𝑒 + "'r'n"
      + "Content-Length: " + 𝑤ℎ𝑜𝑙𝑒(𝐮𝐩𝐛 𝑏𝑜𝑑𝑦, 0) + "'r'n"
      + "Connection: close'r'n"
      + "'r'n"
      + 𝑏𝑜𝑑𝑦;

  𝐢𝐧𝐭 𝑝𝑜𝑟𝑡 ← 8080;
  𝐢𝐟 𝑎𝑟𝑔𝑐 ≥ 2 𝐭𝐡𝐞𝐧
    𝑝𝑜𝑟𝑡 ← 𝑠2𝑖(𝑎𝑟𝑔𝑣(2))
  𝐟𝐢;

  { SQLite-Datenbank oeffnen; bei Fehler beenden. }
  𝐬𝐪𝐥𝐢𝐭𝐞 db;
  𝐢𝐧𝐭 rc ← sqlite_open(db_path, db);
  𝐢𝐟 rc /= 0 𝐭𝐡𝐞𝐧
    𝑝𝑢𝑡𝑠("Fehler: Konnte die Chinook-Datenbank nicht oeffnen.'n");
    posix_exit(1)
  𝐟𝐢;

  𝐢𝐧𝐭 listen_fd ← socket_listen(𝑝𝑜𝑟𝑡);
  𝐢𝐟 listen_fd < 0 𝐭𝐡𝐞𝐧
    𝑝𝑢𝑡𝑠("Fehler: Konnte Port " + 𝑤ℎ𝑜𝑙𝑒(𝑝𝑜𝑟𝑡, 0) + " nicht belegen.'n");
    posix_exit(1)
  𝐟𝐢;

  𝑝𝑢𝑡𝑠("Lausche auf Port " + 𝑤ℎ𝑜𝑙𝑒(𝑝𝑜𝑟𝑡, 0) + " ...'n");

  { Ein Worker: liest die Request-Zeile vom Client-Descriptor, fuehrt fuer
    den Pfad die passende SELECT-Abfrage gegen die Chinook-Datenbank aus
    und antwortet mit dem JSON-Ergebnis. Unbekannte Pfade bekommen 404. }
  𝐩𝐫𝐨𝐜(𝐢𝐧𝐭) 𝐯𝐨𝐢𝐝 handle_connection =
    (𝐢𝐧𝐭 client_fd) 𝐯𝐨𝐢𝐝:
      𝐛𝐞𝐠𝐢𝐧
        𝐬𝐭𝐫𝐢𝐧𝐠 𝑟𝑒𝑞𝑢𝑒𝑠𝑡 ← read_line(client_fd, 4096);
        𝐬𝐭𝐫𝐢𝐧𝐠 𝑝𝑎𝑡ℎ ← extract_path(𝑟𝑒𝑞𝑢𝑒𝑠𝑡);
        𝐬𝐭𝐫𝐢𝐧𝐠 𝑏𝑜𝑑𝑦 ← "";
        𝐬𝐭𝐫𝐢𝐧𝐠 𝑠𝑡𝑎𝑡𝑢𝑠 ← "404 Not Found";
        𝐢𝐟 𝑝𝑎𝑡ℎ = "/" 𝐭𝐡𝐞𝐧
          { Wurzel: interaktiver Mini-DB-Browser (HTML + JavaScript) }
          𝑏𝑜𝑑𝑦 ← index_html;
          𝑠𝑡𝑎𝑡𝑢𝑠 ← "200 OK"
        𝐞𝐥𝐢𝐟 𝑝𝑎𝑡ℎ = "/api/tables" 𝐭𝐡𝐞𝐧
          { JSON-Liste aller Tabellen-Routen, dynamisch aus der
            Routentabelle gebaut }
          𝑏𝑜𝑑𝑦 ← "{ ""tables"" : [";
          𝐟𝐨𝐫 𝑖 𝐟𝐫𝐨𝐦 𝐥𝐰𝐛 𝑟𝑜𝑢𝑡𝑒𝑠 𝐭𝐨 𝐮𝐩𝐛 𝑟𝑜𝑢𝑡𝑒𝑠 𝐝𝐨
            𝐢𝐟 (𝑝𝑎𝑡ℎ 𝐨𝐟 𝑟𝑜𝑢𝑡𝑒𝑠[𝑖])[1:5] = "/api/" 𝐭𝐡𝐞𝐧
              𝐢𝐟 𝑖 > 𝐥𝐰𝐛 𝑟𝑜𝑢𝑡𝑒𝑠 𝐭𝐡𝐞𝐧
                𝑏𝑜𝑑𝑦 ← 𝑏𝑜𝑑𝑦 + ","
              𝐟𝐢;
              𝑏𝑜𝑑𝑦 ← 𝑏𝑜𝑑𝑦 + """" + (𝑝𝑎𝑡ℎ 𝐨𝐟 𝑟𝑜𝑢𝑡𝑒𝑠[𝑖]) + """"
            𝐟𝐢
          𝐨𝐝;
          𝑏𝑜𝑑𝑦 ← 𝑏𝑜𝑑𝑦 + "] }";
          𝑠𝑡𝑎𝑡𝑢𝑠 ← "200 OK"
        𝐞𝐥𝐢𝐟 𝑝𝑎𝑡ℎ = "/api/health" 𝐭𝐡𝐞𝐧
          𝑏𝑜𝑑𝑦 ← "{ ""status"" : ""ok"" }";
          𝑠𝑡𝑎𝑡𝑢𝑠 ← "200 OK"
        𝐞𝐥𝐬𝐞
          𝐟𝐨𝐫 𝑖 𝐟𝐫𝐨𝐦 𝐥𝐰𝐛 𝑟𝑜𝑢𝑡𝑒𝑠 𝐭𝐨 𝐮𝐩𝐛 𝑟𝑜𝑢𝑡𝑒𝑠 𝐝𝐨
            𝐢𝐟 𝑝𝑎𝑡ℎ 𝐨𝐟 𝑟𝑜𝑢𝑡𝑒𝑠[𝑖] = 𝑝𝑎𝑡ℎ 𝐭𝐡𝐞𝐧
              { Select der Tabelle; maximal 50 Zeilen pro Antwort }
              𝐬𝐭𝐫𝐢𝐧𝐠 𝑞 ← "SELECT * FROM " + (𝑡𝑎𝑏𝑙𝑒 𝐨𝐟 𝑟𝑜𝑢𝑡𝑒𝑠[𝑖]) + " LIMIT 50;";
              𝑏𝑜𝑑𝑦 ← "{ ""table"" : """ + (𝑡𝑎𝑏𝑙𝑒 𝐨𝐟 𝑟𝑜𝑢𝑡𝑒𝑠[𝑖]) + """, ""rows"" : "
                       + sqlite_exec_json(db, 𝑞) + " }";
              𝑠𝑡𝑎𝑡𝑢𝑠 ← "200 OK"
            𝐟𝐢
          𝐨𝐝
        𝐟𝐢;
        𝐢𝐟 𝑠𝑡𝑎𝑡𝑢𝑠 = "404 Not Found" 𝐭𝐡𝐞𝐧
          𝑏𝑜𝑑𝑦 ← "{ ""error"" : ""not found"", ""path"" : """ + 𝑝𝑎𝑡ℎ + """ }"
        𝐟𝐢;
        𝐬𝐭𝐫𝐢𝐧𝐠 𝑟𝑒𝑠𝑝𝑜𝑛𝑠𝑒 ←
          http_response(𝑠𝑡𝑎𝑡𝑢𝑠,
                        𝐢𝐟 𝑝𝑎𝑡ℎ = "/" 𝐭𝐡𝐞𝐧 "text/html; charset=utf-8"
                        𝐞𝐥𝐬𝐞 "application/json" 𝐟𝐢,
                        𝑏𝑜𝑑𝑦);
        write_all(client_fd, 𝑟𝑒𝑠𝑝𝑜𝑛𝑠𝑒);
        𝑓𝑐𝑙𝑜𝑠𝑒(client_fd)
      𝐞𝐧𝐝;

  𝐢𝐧𝐭 nr_workers ← 4;
  𝐢𝐟 𝑎𝑟𝑔𝑐 ≥ 3 𝐭𝐡𝐞𝐧
    nr_workers ← 𝑠2𝑖(𝑎𝑟𝑔𝑣(3))
  𝐟𝐢;

  { Feste Anzahl von Worker-Threads starten; accept() wird im Thread
    ausgefuehrt und vom Kern serialisiert }
  server_serve(listen_fd, nr_workers, handle_connection)
𝐞𝐧𝐝
